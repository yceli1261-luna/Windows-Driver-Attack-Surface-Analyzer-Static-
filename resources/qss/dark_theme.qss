/* DASA dark theme - layered on top of the Fusion QPalette set in
 * ThemeManager::applyDarkTheme(). Targets the professional-tool look the
 * brief asks for (dockable panels, tabs, sidebar nav) rather than the
 * default Fusion chrome. */

QMainWindow, QDialog {
    background-color: #252526;
}

QMainWindow::separator {
    background-color: #1e1e1e;
    width: 4px;
    height: 4px;
}

QMenuBar {
    background-color: #2d2d30;
    color: #dcdcdc;
    border-bottom: 1px solid #1e1e1e;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #3e3e42;
}

QMenu {
    background-color: #2d2d30;
    color: #dcdcdc;
    border: 1px solid #1e1e1e;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 32px 6px 20px;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 4px 8px;
}

QMenu::item:selected {
    background-color: #0e639c;
}

QDockWidget {
    color: #9a9a9a;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

/* The tab already names the dock, so keep its title strip slim. */
QDockWidget::title {
    background-color: #252526;
    padding: 3px 10px;
    border-bottom: 1px solid #1e1e1e;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #b0b0b0;
    padding: 7px 16px;
    margin-right: 1px;
    border: 1px solid #1e1e1e;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: #333337;
    color: #dcdcdc;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-bottom: 2px solid #0e639c;
}

/* Scroll arrows for tab bars that overflow: opaque and wide enough to
   click, so they cover the clipped tab instead of drawing over its text. */
QTabBar::scroller {
    width: 56px;
}

QTabBar QToolButton {
    background-color: #333337;
    border: 1px solid #1e1e1e;
    min-width: 26px;
}

QTabBar QToolButton:hover {
    background-color: #3e3e42;
}

QTabWidget::pane {
    border: 1px solid #1e1e1e;
    top: -1px;
}

QLineEdit {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px 8px;
    selection-background-color: #0e639c;
}

QLineEdit:focus {
    border-color: #0e639c;
}

QSplitter::handle {
    background-color: #1e1e1e;
}

QSplitter::handle:horizontal {
    width: 5px;
}

QSplitter::handle:vertical {
    height: 5px;
}

QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0 8px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #2d2d30;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #4a4a4e;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #5a5a5e;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #dcdcdc;
    padding: 5px 10px;
    border: none;
    border-right: 1px solid #1e1e1e;
    border-bottom: 1px solid #1e1e1e;
}

QTableView, QTreeView, QListView {
    background-color: #1e1e1e;
    color: #dcdcdc;
    alternate-background-color: #252526;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    gridline-color: #333337;
    border: 1px solid #1e1e1e;
}

QTableView::item, QTreeView::item {
    padding: 2px 8px;
}

QPlainTextEdit {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #1e1e1e;
    selection-background-color: #0e639c;
}
